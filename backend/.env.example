# Last Chance backend — environment template. Copy to .env for local dev.
NODE_ENV=development
PORT=3000

# Docker stack (docker compose up -d):
DATABASE_URL=postgres://lastchance:lastchance_dev_only@localhost:5432/lastchance
# Portable local PostgreSQL alternative:
# DATABASE_URL=postgres://lastchance@localhost:55432/lastchance

REDIS_URL=redis://localhost:6379

# Pretty-print logs in dev (pino-pretty). Leave unset in production.
LOG_PRETTY=1
