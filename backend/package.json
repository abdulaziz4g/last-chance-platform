{
  "name": "@lastchance/backend",
  "version": "0.1.0",
  "description": "Last Chance platform — NestJS core (Phase 2)",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node -r reflect-metadata src/main.ts",
    "test": "jest",
    "smoke": "ts-node -r reflect-metadata scripts/integration-smoke.ts",
    "smoke:payments": "ts-node -r reflect-metadata scripts/integration-smoke-payments.ts",
    "smoke:phase6": "ts-node -r reflect-metadata scripts/integration-smoke-phase6.ts",
    "smoke:search": "ts-node -r reflect-metadata scripts/integration-smoke-search.ts",
    "smoke:deals": "ts-node -r reflect-metadata scripts/integration-smoke-deals.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-fastify": "^11.1.0",
    "@nestjs/platform-ws": "^11.1.28",
    "@nestjs/websockets": "^11.1.28",
    "@opensearch-project/opensearch": "^2.13.0",
    "bullmq": "^5.56.0",
    "ioredis": "^5.6.0",
    "jose": "^5.10.0",
    "pg": "^8.16.0",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.21.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/ws": "^8.18.1",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "ts-jest": "^29.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/*.spec.ts"
    ]
  }
}
